node_modules/
dist/
.next/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
*.log
sbom/
# R7: local secret handoff (0600) — never committed
.eye-local/
# transient test-run state — never tracked as evidence
test-results/
playwright-report/

# Gate-2 §10: evidence is NEVER part of the source candidate it describes.
# Everything under evidence/ is produced by RUNNING the frozen source candidate,
# so it is absent from the source commit and recorded afterwards in a separate
# evidence-attestation commit (which tracks it explicitly). It is intentionally
# NOT ignored here — ignoring it would prevent that attestation.

# Gate evidence packaging (Gate-2.2 approved packaging decision):
# git bundles and packaged archives are delivered inside the final ZIP, never
# committed into the repository. Ordinary evidence logs/manifests/docs stay tracked.
evidence/*.bundle
*.zip
THE_EYE_PHASE0_GATE*_*.zip

# Gate-2.2 evidence sequencing: generated gate OUTPUTS are regenerated from the
# FROZEN source during the isolated run and committed only in the evidence-only
# attestation child commit. The GENERATORS live in source; their outputs do not.
evidence/authority-matrix.json
evidence/db-paths/
# C15 runner outputs (regenerated from the frozen SHA at the isolated run):
evidence/supply-chain/supply-chain-manifest.json
evidence/supply-chain/*.stdout.txt
evidence/supply-chain/*.stderr.txt
evidence/supply-chain/gitleaks-worktree.json
evidence/supply-chain/gitleaks-history.json
# C16 closure outputs (regenerated deterministically from the frozen SHA at the
# isolated run; byte-identical across runs, so nothing is lost by not tracking them):
evidence/supply-chain/c16/

# C17 preliminary evidence (gitignored until the final freeze child)
evidence/c17/

# C18.1.10 — the frozen c18-legacy-53a4eec predecessor imports the production contracts by a
# RELATIVE path, so it can only execute if a shim sits at exactly
# apps/api/test/gate/packages/contracts/dist/index.js. That path falls under the `dist/` rule
# above, so it is un-ignored explicitly here (the directory first, then the file, as git
# requires). It is a committed test fixture, not build output.
!apps/api/test/gate/packages/contracts/dist/
!apps/api/test/gate/packages/contracts/dist/index.js

# The pinned cosign the C19 controls execute. It is a 133 MB BINARY, acquired by digest-verified
# download from scripts/gate/lib/c19-cosign.json — never committed, and never trusted for merely
# reporting the right version.
.c19-tools/
