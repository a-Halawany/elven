# The Eye — local development profile ONLY (EXC-P0-005).
# Gate-2 §8: this file contains NO secret values. Every entry below is blank on
# purpose — the local workflow generates real values into the 0600, gitignored
# .eye-local/env handoff (see scripts/local-env.mjs and scripts/demo.sh), and any
# caller-supplied environment value takes precedence. Never place a production
# credential in a .env file.

# ---- Connection topology (non-secret) --------------------------------------
EYE_DB_HOST=localhost
EYE_DB_PORT=5432
EYE_DB_NAME=eye
EYE_REDIS_HOST=localhost
EYE_REDIS_PORT=6379
EYE_RUNTIME_PORT=3401

# ---- Role names (non-secret; least-privilege roles from migration 0009) ----
EYE_DB_MIGRATE_USER=eye
EYE_DB_APP_USER=eye_app
EYE_DB_COMMIT_USER=eye_commit
EYE_DB_IDENTITY_USER=eye_identity
EYE_DB_PUBLISHER_USER=eye_publisher
EYE_DB_VERIFIER_USER=eye_verifier
EYE_DB_ALLOCATOR_USER=eye_audit_allocator
# Break-glass recovery role. NOT loaded by any application pool — operator use
# only, via the migration/recovery path.
EYE_DB_RECOVERY_USER=eye_recovery

# ---- Secrets: intentionally EMPTY (generated per environment) --------------
# Superuser/migrate password for the local Compose database:
EYE_DB_PASSWORD=
EYE_DB_MIGRATE_PASSWORD=
# One credential per authority — a compromise of one cannot reach another:
EYE_DB_APP_PASSWORD=
EYE_DB_COMMIT_PASSWORD=
EYE_DB_IDENTITY_PASSWORD=
EYE_DB_PUBLISHER_PASSWORD=
EYE_DB_VERIFIER_PASSWORD=
EYE_DB_ALLOCATOR_PASSWORD=
EYE_DB_RECOVERY_PASSWORD=
# Redis requires authentication in the local profile:
EYE_REDIS_PASSWORD=
# Access-token signing key:
EYE_IDENTITY_JWT_SECRET=
# One-time bootstrap secret (>=16 chars). Forced rotation on first sign-in;
# disabled if unused for 24h. There is NO default anywhere on this path.
EYE_BOOTSTRAP_ADMIN=platform-admin
EYE_BOOTSTRAP_PASSWORD=
# Ephemeral test credentials (generated; never fixed literals):
EYE_TEST_BOOTSTRAP_PASSWORD=
EYE_TEST_ADMIN_PASSWORD=
