{
  "name": "the-eye",
  "private": true,
  "version": "0.0.1",
  "description": "The Eye \u2014 The Operating System for Strategic Intelligence (Phase 0: Foundation & Governance Spine)",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:migrate": "pnpm --filter @eye/api db:migrate",
    "db:bootstrap": "pnpm --filter @eye/api db:bootstrap",
    "license:check": "node scripts/license-inventory.mjs",
    "gate:supply-chain": "node scripts/gate/supply-chain.mjs",
    "gate:closures": "node scripts/gate/generate-closures.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "dependency-cruiser": "18.1.1",
    "packageurl-js": "2.0.1",
    "yaml": "2.9.0"
  }
}
